{
  "expo": {
    "name": "Patrimore",
    "slug": "patrimore",
    "version": "1.5.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.patrimore.patrimore",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.patrimore.patrimore",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para que los usuarios puedan escanear documentos o tomar fotografías.",
        "NSUserTrackingUsageDescription": "Usamos esta información para ofrecerte anuncios personalizados y mejorar tu experiencia en la app.",
        "NSLocationWhenInUseUsageDescription": "Esta app necesita acceso a tu ubicación para mostrarte información financiera relevante a tu zona y mejorar tu experiencia.",
        "NSFaceIDUsageDescription": "Patrimore utiliza Face ID para permitirte acceder de forma rápida y segura a tu información financiera."
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.patrimore.patrimore.onesignal"
        ]
      },
      "appleTeamId": "JJ55Y59DRG"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ff6501"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.patrimore.patrimore",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "devTeam": "JJ55Y59DRG",
          "iPhoneDeploymentTarget": "15.1"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Patrimore utiliza Face ID para permitirte acceder de forma rápida y segura a tu información financiera."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ff6501"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Usamos esta información para ofrecerte anuncios personalizados y mejorar tu experiencia en la app."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "expo-asset",
      "expo-secure-store",
      [
        "react-native-auth0",
        {
          "domain": "auth.patrimore.com"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5344f00-fb53-49b2-a6bb-5d64c787e0c9"
      }
    },
    "owner": "patrimore",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a5344f00-fb53-49b2-a6bb-5d64c787e0c9"
    }
  }
}