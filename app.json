{
  "expo": {
    "name": "Patrimore",
    "slug": "patrimore",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.patrimore.patrimore",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.patrimore.patrimore",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para que los usuarios puedan escanear documentos o tomar fotografías.",
        "NSUserTrackingUsageDescription": "Usamos esta información para ofrecerte anuncios personalizados y mejorar tu experiencia en la app."
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.patrimore.patrimore.onesignal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ff6501"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.patrimore.patrimore"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ff6501"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Usamos esta información para ofrecerte anuncios personalizados y mejorar tu experiencia en la app."
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "react-native-auth0",
        {
          "domain": "auth.patrimore.com"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5344f00-fb53-49b2-a6bb-5d64c787e0c9"
      }
    },
    "owner": "patrimore",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a5344f00-fb53-49b2-a6bb-5d64c787e0c9"
    }
  }
}
