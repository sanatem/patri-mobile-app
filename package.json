{
  "name": "patrimore-financial-app",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "dev:css": "tailwindcss -i ./tailwind.css -o ./app.css --watch",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test -c ios.sim.debug",
    "test:e2e:android": "detox test -c android.emu.debug",
    "test:browserstack": "node e2e/browserstack/run-tests.js",
    "build:android": "node scripts/toggle-auth0.js enable && eas build -p android --profile production",
    "build:ios": "node scripts/toggle-auth0.js disable && eas build -p ios --profile production"
  },
  "dependencies": {
    "@ant-design/icons-react-native": "^2.3.2",
    "@ant-design/react-native": "^4.2.0",
    "@expo-google-fonts/inter": "^0.2.3",
